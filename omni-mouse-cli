#!/usr/bin/python3
"""Command-Line Interface for Omni Mouse Studio (Delux M618XSD & Inphic W1)."""

from __future__ import annotations

import argparse
import json
import os
import sys

ROOT = os.path.dirname(os.path.realpath(__file__))
for _candidate in (ROOT, "/usr/lib/omni-mouse-studio"):
    if os.path.isdir(os.path.join(_candidate, "omni_mouse")) and _candidate not in sys.path:
        sys.path.insert(0, _candidate)
        ROOT = _candidate
        break

from omni_mouse.config import CONFIG_PATH, load_config, save_config
from omni_mouse.daemon import query_daemon
from omni_mouse.hardware import (
    INPHIC_LIGHT_MODES,
    LIGHT_MODES,
    InphicW1Session,
    M618XSDSession,
    PollingRate,
    find_m618xsd_node,
    list_inphic_w1_nodes,
)
from omni_mouse.hardware.inphic_w1 import is_inphic_config_node, load_inphic_state, save_inphic_state, snap_inphic_cpi


def _parse_rgb(text: str) -> tuple[int, int, int]:
    s = text.strip().lstrip("#")
    if "," in s:
        parts = [int(x.strip()) for x in s.split(",")]
        if len(parts) != 3:
            raise ValueError("RGB 格式应为 R,G,B 或 #RRGGBB")
        return (parts[0], parts[1], parts[2])
    if len(s) == 6:
        return (int(s[0:2], 16), int(s[2:4], 16), int(s[4:6], 16))
    raise ValueError("RGB 格式应为 R,G,B 或 #RRGGBB")


def _resolve_active_model() -> str:
    cfg = load_config(CONFIG_PATH)
    pref = cfg.preferred_model
    if pref in ("inphic_w1", "delux_m618xsd"):
        return pref
    dm = query_daemon("status")
    if dm and dm.get("ok") and dm.get("grabbed") and dm.get("device_model") in ("inphic_w1", "delux_m618xsd"):
        return dm["device_model"]
    if find_m618xsd_node() is not None:
        return "delux_m618xsd"
    if any(is_inphic_config_node(n) for n in list_inphic_w1_nodes()):
        return "inphic_w1"
    return "delux_m618xsd"


def cmd_status(args: argparse.Namespace) -> int:
    active_model = _resolve_active_model()
    cfg = load_config(CONFIG_PATH)
    out: dict = {
        "preferred_model": cfg.preferred_model,
        "active_model": active_model,
        "daemon": query_daemon("status"),
    }
    if active_model == "inphic_w1":
        cfg_nodes = [n for n in list_inphic_w1_nodes() if is_inphic_config_node(n)]
        node = cfg_nodes[0] if cfg_nodes else None
        st = load_inphic_state()
        out["hardware"] = {
            "model": "inphic_w1",
            "node": node.path if node else None,
            "accessible": bool(node and node.accessible),
            "firmware": f"{node.name} ({node.vid:04x}:{node.pid:04x})" if node else "Inphic W1 (未连接)",
            "polling": {"hz": 125},
            "dpi": st.to_dpi_dict(),
            "lighting": st.to_lighting_dict(),
            "buttons": st.to_buttons_dict(),
        }
    else:
        try:
            with M618XSDSession() as session:
                hw = session.read_all(profile=1)
                out["hardware"] = {
                    "model": "delux_m618xsd",
                    "node": hw["node"],
                    "firmware": hw["firmware"],
                    "battery": (
                        {"percent": hw["battery"].percent, "state": hw["battery"].state_label}
                        if hw["battery"]
                        else None
                    ),
                    "polling": hw["polling"].to_dict(),
                    "dpi": hw["dpi"].to_dict(),
                    "lighting": hw["lighting"].to_dict(),
                    "buttons": hw["buttons"].to_dict(),
                }
        except Exception as exc:
            out["hardware_error"] = str(exc)

    if args.json:
        print(json.dumps(out, ensure_ascii=False, indent=2))
        return 0

    title = "英菲克 Inphic W1" if active_model == "inphic_w1" else "多彩 Delux M618XSD"
    print(f"=== {title} 状态总览 (型号策略: {cfg.preferred_model}) ===")
    if "hardware" in out:
        hw = out["hardware"]
        print(f"硬件节点 : {hw['node'] or '未连接'}  |  识别: {hw['firmware']}")
        if hw.get("battery"):
            print(f"电池状态 : {hw['battery']['percent']}% ({hw['battery']['state']})")
        print(f"回报率   : {hw['polling']['hz']} Hz")
        cur_st = hw["dpi"]["current_stage"]
        stages_str = ", ".join(
            f"{'*' if s['stage'] == cur_st else ''}[{s['stage']}]{s['dpi']}{'CPI' if active_model == 'inphic_w1' else 'DPI'}"
            for s in hw["dpi"]["stages"]
            if s["enabled"]
        )
        print(f"档位参数 : {stages_str}")
        lt = hw["lighting"]
        if active_model == "inphic_w1":
            print(f"背光灯效 : {lt['mode_label']} (0x{lt['mode']:02X})")
        else:
            print(
                f"RGB 灯光 : {lt['mode_label']} | 颜色 RGB{tuple(lt['rgb'])} | 亮度 {lt['brightness']}/8 | "
                f"休眠 {lt['light_sleep_minutes']}m/{lt['deep_sleep_minutes']}m"
            )
    else:
        print(f"硬件状态 : {out.get('hardware_error')}")

    dm = out["daemon"]
    if dm and dm.get("ok"):
        print(f"智能守护 : 运行中 (PID {dm['pid']}) | 接管设备: {dm['device_path'] or '待命'} ({dm.get('device_name') or '无'})")
        print(f"当前方案 : {dm['active_profile']['name']}  (窗口: {dm['window']['label']})")
    else:
        print("智能守护 : 未运行 (可执行 ./omni-mouse-daemon 启动)")
    return 0


def cmd_set_model(args: argparse.Namespace) -> int:
    cfg = load_config(CONFIG_PATH)
    cfg.preferred_model = args.model
    save_config(cfg, CONFIG_PATH)
    query_daemon("reload")
    print(f"已将型号管理策略切换为: {args.model}")
    return 0


def cmd_set_dpi(args: argparse.Namespace) -> int:
    active_model = _resolve_active_model()
    if active_model == "inphic_w1":
        st = load_inphic_state()
        if args.stage:
            st.current_stage = max(1, min(4, args.stage))
        if args.value:
            st.stages_cpi[st.current_stage - 1] = snap_inphic_cpi(args.value)
        st.user_configured = True
        with InphicW1Session() as session:
            session.write_dpi(st)
        save_inphic_state(st)
        print(f"已更新 Inphic W1 CPI：当前第 {st.current_stage} 档 = {st.stages_cpi[st.current_stage - 1]} CPI")
        return 0

    with M618XSDSession() as session:
        dpi_cfg = session.read_dpi()
        if args.stage:
            dpi_cfg.current_stage = max(1, min(5, args.stage))
        if args.value:
            target_stage = dpi_cfg.current_stage
            dpi_cfg.set_stage_dpi(target_stage, args.value)
        session.write_dpi(dpi_cfg)
        print(f"已更新板载 DPI：当前第 {dpi_cfg.current_stage} 档 = {dpi_cfg.dpi[dpi_cfg.current_stage - 1]} DPI")
    return 0


def cmd_set_poll(args: argparse.Namespace) -> int:
    if _resolve_active_model() == "inphic_w1":
        raise SystemExit("英菲克 Inphic W1 有线版硬件固定为 125 Hz USB 回报率，不支持切换回报率。")
    with M618XSDSession() as session:
        session.write_polling(PollingRate(profile=1, hz=args.hz))
        print(f"已将板载无线/有线回报率设为 {args.hz} Hz")
    return 0


def cmd_set_rgb(args: argparse.Namespace) -> int:
    if _resolve_active_model() == "inphic_w1":
        inphic_lookup = {k: code for code, (k, _) in INPHIC_LIGHT_MODES.items()}
        alias_map = {"steady": "static", "off": "off", "breath": "breathe_4s", "stream": "pulse_2s", "neon": "breathe_3s"}
        st = load_inphic_state()
        if args.mode:
            target_key = alias_map.get(args.mode, args.mode)
            if target_key not in inphic_lookup:
                raise SystemExit(f"未知 Inphic 背光模式 {args.mode!r}，可选: {', '.join(inphic_lookup)}")
            st.light_mode = inphic_lookup[target_key]
        if args.color:
            st.light_rgb = list(_parse_rgb(args.color))
        st.user_configured = True
        with InphicW1Session() as session:
            session.write_lighting(st)
        save_inphic_state(st)
        print(f"已更新 Inphic W1 背光模式：{st.to_lighting_dict()['mode_label']}")
        return 0

    mode_lookup = {k: code for code, (k, _) in LIGHT_MODES.items()}
    with M618XSDSession() as session:
        light = session.read_lighting()
        if args.mode:
            if args.mode not in mode_lookup:
                raise SystemExit(f"未知灯效模式 {args.mode!r}，可选: {', '.join(mode_lookup)}")
            light.mode = mode_lookup[args.mode]
        if args.color:
            light.rgb = _parse_rgb(args.color)
        if args.brightness is not None:
            light.brightness = max(1, min(8, args.brightness))
        if args.speed is not None:
            light.speed = max(1, min(5, args.speed))
            light.led_speed = light.speed
        session.write_lighting(light)
        print(f"已写入板载灯效：{light.mode_label} | RGB{light.rgb} | 亮度 {light.brightness}/8")
    return 0


def cmd_restore_factory(_args: argparse.Namespace) -> int:
    if _resolve_active_model() == "inphic_w1":
        from omni_mouse.hardware import InphicW1State

        st = InphicW1State(user_configured=True)
        with InphicW1Session() as session:
            session.write_all(st)
        save_inphic_state(st)
        print("已恢复英菲克 Inphic W1 出厂默认硬件寄存器配置 (800/1200/1600/2400 CPI + 标准呼吸灯)")
        return 0

    backup = os.path.join(ROOT, "factory_backup.json")
    with M618XSDSession() as session:
        restored = session.restore_backup_file(backup)
        print(f"已从 {backup} 恢复出厂板载报告: {', '.join(restored)}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="多功能鼠标智控工具 (Delux M618XSD & Inphic W1)")
    sub = parser.add_subparsers(dest="cmd")

    p_st = sub.add_parser("status", help="查看当前鼠标型号、CPI/DPI、灯光及后台智能守护状态")
    p_st.add_argument("--json", action="store_true", help="输出 JSON 格式")
    p_st.set_defaults(func=cmd_status)

    p_md = sub.add_parser("model", help="切换设备识别模式 (auto / inphic_w1 / delux_m618xsd)")
    p_md.add_argument("model", choices=["auto", "inphic_w1", "delux_m618xsd"])
    p_md.set_defaults(func=cmd_set_model)

    p_dpi = sub.add_parser("dpi", help="切换 CPI/DPI 档位或修改指定档位数值")
    p_dpi.add_argument("--stage", type=int, choices=[1, 2, 3, 4, 5], help="切换到第 1..5 档 (W1 为 1..4 档)")
    p_dpi.add_argument("--value", type=int, help="修改当前档位数值 (M618XSD: 400..4000, W1: 400..4800)")
    p_dpi.set_defaults(func=cmd_set_dpi)

    p_poll = sub.add_parser("poll", help="设置 M618XSD 板载回报率 (125 / 250 / 500 / 1000 Hz)")
    p_poll.add_argument("hz", type=int, choices=[125, 250, 500, 1000])
    p_poll.set_defaults(func=cmd_set_poll)

    all_modes = list(dict.fromkeys([k for _, (k, _) in LIGHT_MODES.items()] + [k for _, (k, _) in INPHIC_LIGHT_MODES.items()]))
    p_rgb = sub.add_parser("rgb", help="设置板载 RGB / 背光模式、颜色与亮度")
    p_rgb.add_argument("--mode", choices=all_modes, help="灯效模式")
    p_rgb.add_argument("--color", help="RGB 颜色，例如 '#00FF88' 或 '0,255,136'")
    p_rgb.add_argument("--brightness", type=int, help="亮度 1..8 (M618XSD)")
    p_rgb.add_argument("--speed", type=int, help="动态速度 1..5 (M618XSD)")
    p_rgb.set_defaults(func=cmd_set_rgb)

    p_rst = sub.add_parser("restore-factory", help="一键恢复当前鼠标出厂硬件配置")
    p_rst.set_defaults(func=cmd_restore_factory)

    p_prof = sub.add_parser("profiles", help="列出所有智能按应用切换方案")
    p_prof.set_defaults(
        func=lambda _: (
            print(json.dumps(load_config(CONFIG_PATH).to_dict(), ensure_ascii=False, indent=2)),
            0,
        )[1]
    )

    args = parser.parse_args()
    if not getattr(args, "cmd", None):
        args.json = False
        return cmd_status(args)
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
