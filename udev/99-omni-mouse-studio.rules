# Multi-Mouse Linux Driver udev rules (Delux M618XSD & Inphic W1)
# Grants the active desktop user non-root access to:
# 1. Delux / Compx / LXDDZ (1d57) & Inphic / Instant Microelectronics (30fa, 18f8) HID raw configuration nodes
# 2. Input event nodes for button/thumbwheel/side-wheel remapping & 4-way gestures
# 3. /dev/uinput for virtual keyboard/mouse/scroll injection under Wayland & X11

SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1d57", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="input", ATTRS{idVendor}=="1d57", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="30fa", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="input", ATTRS{idVendor}=="30fa", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="18f8", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="input", ATTRS{idVendor}=="18f8", MODE="0660", TAG+="uaccess"
KERNEL=="uinput", SUBSYSTEM=="misc", MODE="0660", TAG+="uaccess", OPTIONS+="static_node=uinput"
