# Delux M618XSD Linux Driver udev rules
# Grants the active desktop user non-root access to:
# 1. Delux / Compx / LXDDZ 2.4G wireless receiver & wired USB HID raw configuration nodes
# 2. Input event nodes for button/thumbwheel remapping & gestures
# 3. /dev/uinput for virtual keyboard/mouse/scroll injection under Wayland & X11

SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1d57", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="input", ATTRS{idVendor}=="1d57", MODE="0660", TAG+="uaccess"
KERNEL=="uinput", SUBSYSTEM=="misc", MODE="0660", TAG+="uaccess", OPTIONS+="static_node=uinput"
