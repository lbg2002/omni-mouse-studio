#!/usr/bin/python3
"""Run the ultra-low-resource Delux M618XSD Smart Per-App & Gesture Daemon."""

import os
import sys

for candidate in (os.path.dirname(os.path.realpath(__file__)), "/usr/lib/delux-m618xsd"):
    if os.path.isdir(os.path.join(candidate, "delux_m618xsd")) and candidate not in sys.path:
        sys.path.insert(0, candidate)
        break

from delux_m618xsd.daemon import SmartMouseDaemon

if __name__ == "__main__":
    daemon = SmartMouseDaemon()
    raise SystemExit(daemon.run())
