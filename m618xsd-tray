#!/usr/bin/python3
"""Run the lightweight Delux M618XSD Top-Bar / System Tray Indicator."""

import os
import sys

for candidate in (os.path.dirname(os.path.realpath(__file__)), "/usr/lib/delux-m618xsd"):
    if os.path.isdir(os.path.join(candidate, "delux_m618xsd")) and candidate not in sys.path:
        sys.path.insert(0, candidate)
        break

from delux_m618xsd.ui import run_tray

if __name__ == "__main__":
    raise SystemExit(run_tray())
